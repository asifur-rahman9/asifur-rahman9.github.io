---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.tsx';
import HeroScene from '../components/HeroScene.tsx';
import ProjectExplorer from '../components/ProjectExplorer.tsx';
import DuckGame from '../components/DuckGame.tsx';
import { site, projects, minorProjects } from '../data/site';
import { fetchActivity, fetchRepos, repoSlug } from '../lib/github';
// GitHub data baked in at build time (the browser refreshes it on load).
// CI passes GITHUB_TOKEN for a higher rate limit.
const user = repoSlug(site.github);
const slugs = [...projects.map((p) => repoSlug(p.repo)), ...minorProjects.map((m) => `${user}/${m.repo}`)];
const [activity, repos] = await Promise.all([
  fetchActivity(slugs, process.env.GITHUB_TOKEN, 5),
  fetchRepos(user, process.env.GITHUB_TOKEN),
]);
const year = new Date().getFullYear();
---
<Base>
  <header><div class="wrap">
    <a class="logo" href="#about">Asifur Rahman<span class="cursor" aria-hidden="true"></span></a>
    <nav aria-label="Primary">
      <a href="#projects">Projects</a><a href="#contact">Contact</a>
      <a class="ext" href={site.github}>GitHub</a><a class="ext" href={site.linkedin}>LinkedIn</a>
    </nav>
  </div></header>

  <main>
    <section id="about"><div class="wrap cli-hero">
      <h1 class="sr-only">Asifur Rahman, backend and platform developer</h1>
      <dl class="cli-keys" aria-label="Terminal shortcuts">
        <div><dt><kbd>help</kbd></dt><dd>type it and press Enter</dd></div>
        <div class="kb-only"><dt><kbd>↑</kbd> <kbd>↓</kbd></dt><dd>cycle through commands</dd></div>
      </dl>
      <Terminal client:load />
    </div>
    <HeroScene client:load />
    </section>

    <section id="projects"><div class="wrap sec">
      <div class="sec-head">
        <h2>Projects</h2>
        <p class="sub">My work as a commit history. Pick a commit to read it.</p>
      </div>
      <ProjectExplorer client:idle projects={projects} minor={minorProjects} github={site.github} initial={activity} initialRepos={repos} />
    </div></section>

    <section id="break"><div class="wrap sec">
      <div class="sec-head">
        <h2>Need a break?</h2>
        <p class="sub">Help my duck hop the cacti and snack on the way. Bread doubles your score, corn triples it, shrimp gives 5x for five seconds. Tap to jump, tap again in the air to flap.</p>
      </div>
      <DuckGame client:visible />
    </div></section>

    <section id="contact">
      <div class="wrap contact">
        <h2>Get in touch</h2>
        <p>Open to Summer 2027 software engineering internships and new grad roles in Montreal, Toronto or remote in Canada. Email is the fastest way to reach me.</p>
        <div class="mails">
          <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="mail" href={`mailto:${site.schoolEmail}`}>{site.schoolEmail}</a>
        </div>
        <div class="ctas">
          <a class="btn" href={site.linkedin}>LinkedIn</a><a class="btn" href={site.github}>GitHub</a>
          {site.resume && <a class="btn" href={site.resume}>Resume</a>}
        </div>
      </div>
    </section>
  </main>
  <footer><div class="wrap">
    <span>© {year} Asifur Rahman, Montreal</span>
  </div></footer>
</Base>
