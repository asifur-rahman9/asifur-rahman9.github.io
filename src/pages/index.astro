---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.tsx';
import HeroScene from '../components/HeroScene.tsx';
import ProjectExplorer from '../components/ProjectExplorer.tsx';
import Toolbox from '../components/Toolbox.tsx';
import DogGame from '../components/DogGame.tsx';
import { site, experience, projects, minorProjects, toolGroups, usedIn } from '../data/site';
const year = new Date().getFullYear();
---
<Base>
  <header><div class="wrap">
    <a class="logo" href="#about">Asifur Rahman<span class="cursor" aria-hidden="true"></span></a>
    <nav aria-label="Primary">
      <a class="ext" href="#experience">Experience</a><a href="#projects">Projects</a><a class="ext" href="#toolbox">Toolbox</a><a href="#contact">Contact</a>
      <a class="ext" href={site.github}>GitHub</a><a class="ext" href={site.linkedin}>LinkedIn</a>
    </nav>
  </div></header>

  <main>
    <section id="about"><div class="wrap hero">
      <div class="hero-text">
        <span class="status"><i aria-hidden="true"></i>{site.status}</span>
        <h1>I build backend systems and the pipelines that ship them.</h1>
        <p class="lede">I'm a final-year CS (Co-op) student at Concordia, graduating in 2027. I spent two co-op terms on BMO Capital Markets' platform and infrastructure teams, working on Java services, AWS, Jenkins and database automation.</p>
        <div class="ctas">
          <a class="btn primary" href="#projects">See my projects</a>
          {site.resume && <a class="btn" href={site.resume}>Resume ↓</a>}
          <a class="btn" href={`mailto:${site.email}`}>Email me</a>
          <a class="btn" href={site.github}>GitHub</a>
        </div>
      </div>
      <Terminal client:load />
    </div>
    <HeroScene client:load />
    </section>

    <section id="experience"><div class="wrap sec">
      <div class="sec-head">
        <h2>Experience</h2>
      </div>
      <div class="jobs">
        {experience.map((j) => (
          <article class="job">
            <div class="job-org">
              <h3>{j.org}</h3>
              <p>{j.team}</p>
              <div class="tags">{j.stack.map((s) => <span class="tag">{s}</span>)}</div>
            </div>
            <div class="roles">
              {j.roles.map((r) => (
                <div class="role">
                  <div class="role-head"><h4>{r.title}</h4>{r.dates && <span>{r.dates}</span>}</div>
                  <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div></section>

    <section id="projects"><div class="wrap sec">
      <div class="sec-head">
        <h2>Projects</h2>
        <p class="sub">My work as a commit history. Pick a commit to read it.</p>
      </div>
      <ProjectExplorer client:visible projects={projects} minor={minorProjects} github={site.github} />
    </div></section>

    <section id="toolbox"><div class="wrap sec">
      <div class="sec-head">
        <h2>Toolbox</h2>
        <p class="sub">Pick a tool to see where I've used it.</p>
      </div>
      <Toolbox client:visible groups={toolGroups} usedIn={usedIn} />
    </div></section>

    <section id="break"><div class="wrap sec">
      <div class="sec-head">
        <h2>Need a two-minute break?</h2>
        <p class="sub">Help my dog hop over the cacti and grab snacks. Fish doubles your score, chicken triples it, shrimp gives 5x for five seconds. Click, tap or press Space to jump.</p>
      </div>
      <DogGame client:visible />
    </div></section>

    <section id="contact">
      <div class="wrap contact">
        <h2>Get in touch</h2>
        <p>Open to Summer 2027 software engineering internships and new grad roles in Montreal, Toronto or remote in Canada. Email is the fastest way to reach me.</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="ctas">
          <a class="btn" href={site.linkedin}>LinkedIn</a><a class="btn" href={site.github}>GitHub</a>
          {site.resume && <a class="btn" href={site.resume}>Resume</a>}
        </div>
      </div>
    </section>
  </main>
  <footer><div class="wrap">
    <span>© {year} Asifur Rahman, Montreal</span>
    <a href="https://github.com/asifur-rahman9/asifur-rahman9.github.io">Built with Astro and React. View the source</a>
  </div></footer>
</Base>
